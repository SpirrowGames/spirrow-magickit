#!/usr/bin/env bash
# Single source of truth for the spirrow-magickit gate.
# Run identically by CI (.github/workflows/ci.yml) and the autonomous loop's
# implementer (it executes `bash .mindwire-gate`), so the two can never drift.
# Exit 0 = green.
set -euo pipefail

# CI runs `pytest tests/unit -v` and nothing else, so that is what this gate is.
#
# Deliberately NOT stricter than CI. ruff and mypy are configured in this repo
# (pyproject.toml) and are evidently run by hand -- .ruff_cache / .mypy_cache
# exist -- but ci.yml does not run either. Adding them here would block the
# implementer on checks no PR is ever judged by, which is drift in the other
# direction: the loop would enforce a standard the project does not. If those
# checks should gate this repo, add them to ci.yml and to this file in the same
# change, so the "can never drift" property above stays true.
#
# Integration tests are excluded for the same reason CI excludes them: they need
# live prismind / lexora / cognilens and are run against the dev cluster by hand.
# `--extra dev` is required, not cosmetic: pytest-asyncio lives in the dev extra
# and tests/conftest.py imports it at collection time, so without it the gate
# dies with a ModuleNotFoundError before running a single test. CI gets the same
# packages via `pip install -e ".[dev]"`.
uv run --extra dev pytest tests/unit
